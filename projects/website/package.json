{
  "name": "website-anda",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "bun run ands:source",
    "dev": "next dev --turbopack -p 3008",
    "prebuild": "bun run ands:source",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "ands:source": "bun -e \"const text = await Bun.file('ands/ands.txt').text(); await Bun.write('lib/ands/ands-source.ts', '// Generated from ands/ands.txt by the ands:source script in package.json. Do not edit.\\n' + 'export const ANDS_SOURCE = ' + JSON.stringify(text) + ';\\n');\"",
    "lint": "next lint",
    "cf:preview": "CF_WORKERS_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "CF_WORKERS_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.553.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.20.1",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.18",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "sucrase": {
      "glob": "^10.5.0"
    },
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}

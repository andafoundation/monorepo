{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anda-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  // The site is served only on its custom domain. The workers.dev host and the
  // per-version preview URLs would publish an indexable copy of every page.
  "workers_dev": false,
  "preview_urls": false,
  // Each deploy binds the apex to this Worker and creates its DNS record and
  // certificate. The zone must be Active in the deploying account, or the
  // deploy fails.
  "routes": [{ "pattern": "andaphilosophy.com", "custom_domain": true }],
  "compatibility_flags": [
    // Node.js API surface used by Next's server runtime.
    "nodejs_compat",
    // Route fetch() to the public internet rather than back into the Worker.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Unprefixed URLs (/contact -> /nl/contact) depend on Next's router, which
    // is skipped entirely when assets are served first -- producing
    // intermittent 404s. Route every request through the Worker; it still
    // serves assets, just via the asset resolver.
    "run_worker_first": true,
    // Next.js serves a public file only at its exact path. Rewriting to a
    // trailing slash or an index.html, or a fallback page, would let a request
    // reach an asset without passing through the middleware.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "anda-website"
    }
  ],
  // Powers next/image optimization on Workers.
  "images": {
    "binding": "IMAGES"
  }
}

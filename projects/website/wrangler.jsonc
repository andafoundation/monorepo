{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anda-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  // The site is served only on its custom domain. The workers.dev host and the
  // per-version preview URLs would publish an indexable copy of every page.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": [
    // Node.js API surface used by Next's server runtime.
    "nodejs_compat",
    // Route fetch() to the public internet rather than back into the Worker.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Unprefixed URLs (/contact -> /nl/contact) depend on Next's router, which
    // is skipped entirely when assets are served first -- producing
    // intermittent 404s. Route every request through the Worker; it still
    // serves assets, just via the asset resolver.
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "anda-website"
    }
  ],
  // Powers next/image optimization on Workers.
  "images": {
    "binding": "IMAGES"
  }
}
